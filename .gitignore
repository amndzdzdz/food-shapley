# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
.env
.envrc

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Datasets and generated artifacts (see src/food_shapley/paths.py)
data/
runs/
outputs/
wandb/

# Large / binary research artifacts, wherever they end up
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.parquet

# Cluster job output. The log directories themselves are tracked (via
# .gitkeep) because sbatch fails at submit time if --output/--error point at
# a directory that does not exist.
slurm-*.out
*.sbatch.log
slurm/logs/**/*.log

# Credentials — never commit these
*.pem
*.key
secrets.toml
.secrets/

# Editors / OS / local tool settings
.claude/settings.local.json
.idea/
.vscode/
.DS_Store
